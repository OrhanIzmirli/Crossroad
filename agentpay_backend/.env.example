# Agent Pay backend - every environment variable the code reads.
#
# Copy to `.env` (gitignored). IMPORTANT: the app itself only reads TICKETMASTER_API_KEY, GROQ_API_KEY and
# GROQ_MODEL from a `.env` file. Every other variable is read from the PROCESS environment only, so export
# it (or set it in your host's config) before starting uvicorn. Lines starting with `#` show the default.

# --- Explanation provider (watchdog text; never touches amounts). Precedence: Groq > Claude > rule-based ---
# Optional. Groq free-tier key (console.groq.com). If set, Groq writes the dispute explanation.
GROQ_API_KEY=
# Optional. Groq chat model. Default below; llama-3.3-70b-versatile is no longer on Groq's free tier.
GROQ_MODEL=openai/gpt-oss-120b
# Optional. Anthropic key; used when GROQ_API_KEY is unset (or Groq fails). Neither key set = rule-based text.
# ANTHROPIC_API_KEY=
# Optional. Claude model used when ANTHROPIC_API_KEY is the active provider.
# WATCHDOG_MODEL=claude-opus-5

# --- Escrow ---
# Optional. 1 = the disputed delta is locked in the on-chain PDA vault (devnet); unset/0 = JSON ledger (safe default).
AGENT_PAY_ONCHAIN_ESCROW=0
# Optional. Program id of the deployed agent_pay_vault program (default: the devnet deployment below).
AGENT_PAY_VAULT_PROGRAM_ID=CvE7xMfwbpMmCz9Pvt6RsG9tHxNUpbuG5KwyGuFHSxCk

# --- Data sources ---
# Optional. Free Ticketmaster Discovery key (developer.ticketmaster.com). Enables the event-status source for
# event policies that have a venue_name / event id; without it that source is skipped.
TICKETMASTER_API_KEY=
# Optional. Agromonitoring key for the live satellite NDVI vote (include_satellite); without it that vote is skipped.
# AGROMONITORING_API_KEY=
# Optional. The two Open-Meteo rainfall products read for every weather policy.
# RAIN_MODEL_A=best_match
# RAIN_MODEL_B=ecmwf_ifs025

# --- Wallets and limits ---
# Optional (recommended when deploying). JSON array of ints (solana-keygen format) for the insurer wallet that PAYS.
# Unset = generated once into wallet.json next to app/. Contains a private key: never commit it.
# AGENT_WALLET_KEYPAIR=[1,2,3,...]
# Optional. Same format, for the service/treasury wallet (the default payee). Unset = service_wallet.json.
# SERVICE_WALLET_KEYPAIR=[1,2,3,...]
# Optional. Base58 address that receives payouts when a policy has no payee_pubkey. Unset = the service wallet.
# SERVICE_WALLET_ADDRESS=
# Optional. Cap on sum_insured_sol per policy so a typo cannot drain the demo wallet.
# MAX_SUM_INSURED_SOL=5

# --- Not implemented ---
# AGENT_PAY_MOCK_PAYMENT: listed in the plan but NOT read by any code. To run without devnet, swap the import in
# app/main.py from `app.payment` to `app.payment_mock` by hand (see README). Setting this variable does nothing.
# AGENT_PAY_MOCK_PAYMENT=0
